# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY=

# APP_URL: The public URL where this applet is hosted.
APP_URL=

# BALE_WALLET_TOKEN: Server-side Bale Payment Gateway Wallet Token (e.g. WALLET-...)
# Configure securely in Settings -> Secrets. Never hardcode in source code.
BALE_WALLET_TOKEN=

# BALE_BOT_TOKEN: Bale Bot API Token from @botfather (required for real ble.ir invoice links & admin order alerts)
BALE_BOT_TOKEN=

# BALE_ADMIN_CHAT_ID: Your numeric Bale Chat ID to receive instant notifications for every new order & lead
BALE_ADMIN_CHAT_ID=

# BALE_WEBHOOK_SECRET: Random secret path segment protecting /api/payment/bale/webhook/:secret
BALE_WEBHOOK_SECRET=
